# «Семь ночей» — образец окружения. Скопировать в .env и заполнить.
# Полный список — docs/architecture.md §10.1. Пустые значения берут умолчание из src/env.ts.

TELEGRAM_BOT_TOKEN=            # от @BotFather, НИКОГДА не в git
ADMIN_PASSWORD=change-me       # пароль админки, минимум 8 символов
PORT=3700
BIND_HOST=100.91.124.2         # только tailnet, наружу не слушаем
# Telegram user ID владельца и специалиста через запятую; узнать: /whoami в боте.
# Можно оставить пустым и задать позже в админке.
ADMIN_TG_IDS=
DATA_DIR=./data
CONTENT_DIR=./content
BOT_USERNAME=ensoma_robot
SCHEDULER_TICK_MS=30000
# Ускоренный режим для всех новых пользователей: вечер идёт минуты, а не сутки.
DEMO_MODE_DEFAULT=0
ADMIN_COOKIE_SECURE=0          # 1 только когда появится https-домен
LOG_LEVEL=info
# Обязательно UTC: все расчёты идут от tz_offset_min пользователя, пояс машины
# не должен участвовать нигде (§4.3).
TZ=UTC

# ─── озвучка: используется только скриптами (npm run audio:*), сервису не нужна ───
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Голос озвучки. Светлана читает ровно по сценарию; Маша живее, но сама ставит паузы
# и удваивает длину практики — см. docs/tts-decision.md.
TTS_VOICE=ru-RU-SvetlanaNeural
TTS_STYLE=
FFMPEG_BIN=/home/karpushin/.local/bin/ffmpeg
FFPROBE_BIN=/home/karpushin/.local/bin/ffprobe
