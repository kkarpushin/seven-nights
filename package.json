{
  "name": "seven-nights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "«Семь ночей» — Telegram-бот-компаньон для аудиопрактик, админка и лендинг",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build:admin": "vite build --config web/admin/vite.config.ts",
    "dev:admin": "vite --config web/admin/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audio:generate": "tsx scripts/generate-audio.ts",
    "audio:upload": "tsx scripts/upload-audio.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.0",
    "grammy": "^1.46.0",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
